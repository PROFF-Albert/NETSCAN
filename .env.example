# NETSCAN local configuration
NETWATCH_DATABASE_URL=sqlite:///database/netwatch.db
NETWATCH_HOST=127.0.0.1
NETWATCH_PORT=8000
NETWATCH_LOG_LEVEL=INFO
NETWATCH_RATE_LIMIT_PER_MINUTE=60
# Optional NVD 2.0 API key. Leave blank to use the application without NVD.
NETSCAN_NVD_API_KEY=
NETSCAN_NVD_TIMEOUT_SECONDS=8
NETSCAN_MAX_SCAN_CONCURRENCY=128
